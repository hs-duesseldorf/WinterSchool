// Evaluates a surface material once per (already skinned) splat and writes its Emissive Color and Opacity back as the
// splat's color and the splat's opacity multiplied by it (an unconnected Opacity keeps the splat as it is). Material inputs: Vertex Color = splat color + opacity, World Position = splat center,
// Pixel/Vertex Normal = the splat's flattest axis facing the camera, Object/Actor position and bounds = the actor's.
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"
#include "/Engine/Generated/Material.ush"
#define GPU_SIMULATION 1
#include "/Plugin/GaussianSplat/Shared/GaussianSplatShared.h"

float4x4 LocalToWorld;
float4x4 WorldToLocal;
float3 LocalBoundsOrigin;
float3 LocalBoundsExtent;
uint NumSplats;
uint SplatStride;
RWByteAddressBuffer RWSplatBuffer;

static const float SH_C0 = 0.28209479177387814f;

FPrimitiveSceneData MakeSplatPrimitiveData()
{
	FPrimitiveSceneData Data = (FPrimitiveSceneData)0;
	Data.LocalToWorld = DFPromote(LocalToWorld);
	Data.WorldToLocal = DFPromoteInverse(WorldToLocal);
	Data.PreviousLocalToWorld = Data.LocalToWorld;
	Data.PreviousWorldToLocal = Data.WorldToLocal;
	const float3 Origin = mul(float4(LocalBoundsOrigin, 1.0f), LocalToWorld).xyz;
	Data.ObjectWorldPosition = DFPromote(Origin);
	Data.ActorWorldPosition = DFPromote(LocalToWorld[3].xyz);
	Data.ObjectRadius = length(LocalBoundsExtent);
	Data.LocalObjectBoundsMin = LocalBoundsOrigin - LocalBoundsExtent;
	Data.LocalObjectBoundsMax = LocalBoundsOrigin + LocalBoundsExtent;
	return Data;
}

FPrimitiveSceneData GetPrimitiveData(FMaterialVertexParameters Parameters) { return MakeSplatPrimitiveData(); }
FPrimitiveSceneData GetPrimitiveData(FMaterialPixelParameters Parameters) { return MakeSplatPrimitiveData(); }

float3x3 QuatToMatrix(float4 Q)
{
	const float X = Q.x, Y = Q.y, Z = Q.z, W = Q.w;
	return float3x3(
		1 - 2 * (Y * Y + Z * Z), 2 * (X * Y - W * Z), 2 * (X * Z + W * Y),
		2 * (X * Y + W * Z), 1 - 2 * (X * X + Z * Z), 2 * (Y * Z - W * X),
		2 * (X * Z - W * Y), 2 * (Y * Z + W * X), 1 - 2 * (X * X + Y * Y));
}

[numthreads(THREADGROUP_SIZE_1D, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupThreadIndex : SV_GroupIndex)
{
	ResolvedView = ResolveView();
	const uint Index = GetUnWrappedDispatchThreadId(GroupId, GroupThreadIndex, THREADGROUP_SIZE_1D);
	if (Index >= NumSplats)
	{
		return;
	}
	const uint Offset = Index * SplatStride;
	const float3 LocalPosition = asfloat(RWSplatBuffer.Load3(Offset + FGaussianSplatShared::EFloat_PositionOffset));
	const float3 Scale = asfloat(RWSplatBuffer.Load3(Offset + FGaussianSplatShared::EFloat_ScaleOffset));
	const float4 Rotation = asfloat(RWSplatBuffer.Load4(Offset + FGaussianSplatShared::EFloat_RotationOffset));
	const float4 ColorOpacity = asfloat(RWSplatBuffer.Load4(Offset + FGaussianSplatShared::EFloat_ColorOpacityOffset));

	const float3 WorldPosition = mul(float4(LocalPosition, 1.0f), LocalToWorld).xyz;
	const float3 CameraVector = normalize(DFDemote(ResolvedView.WorldCameraOrigin) - WorldPosition);

	// tangent frame from the splat axes (columns of its rotation), normal = flattest axis
	const float3x3 Axes = QuatToMatrix(Rotation);
	const uint N = Scale.x < Scale.y ? (Scale.x < Scale.z ? 0 : 2) : (Scale.y < Scale.z ? 1 : 2);
	const float3 LocalNormal = float3(Axes[0][N], Axes[1][N], Axes[2][N]);
	const float3 LocalTangent = float3(Axes[0][(N + 1) % 3], Axes[1][(N + 1) % 3], Axes[2][(N + 1) % 3]);
	float3 WorldNormal = normalize(mul(LocalNormal, (float3x3)LocalToWorld));
	WorldNormal = dot(WorldNormal, CameraVector) < 0.0f ? -WorldNormal : WorldNormal;
	const float3 WorldTangent = normalize(mul(LocalTangent, (float3x3)LocalToWorld));

	FMaterialPixelParameters MaterialParameters = MakeInitializedMaterialPixelParameters();
	MaterialParameters.VertexColor = half4(saturate(ColorOpacity.xyz * SH_C0 + 0.5f), ColorOpacity.w);
	MaterialParameters.WorldNormal = WorldNormal;
	MaterialParameters.TangentToWorld = half3x3(WorldTangent, cross(WorldNormal, WorldTangent), WorldNormal);
	MaterialParameters.CameraVector = CameraVector;
	MaterialParameters.AbsoluteWorldPosition = DFPromote(WorldPosition);
	MaterialParameters.WorldPosition_NoOffsets = MaterialParameters.AbsoluteWorldPosition;
	MaterialParameters.WorldPosition_CamRelative = WorldPosition + DFHackToFloat(ResolvedView.PreViewTranslation);
	MaterialParameters.WorldPosition_NoOffsets_CamRelative = MaterialParameters.WorldPosition_CamRelative;
	MaterialParameters.LWCData = MakeMaterialLWCData(MaterialParameters);
	MaterialParameters.LWCData.AbsoluteWorldPosition = WSPromote(WorldPosition);
	MaterialParameters.LWCData.LocalToWorld = WSPromote(LocalToWorld);
	MaterialParameters.LWCData.WorldToLocal = WSPromoteInverse(WorldToLocal);
#if NUM_TEX_COORD_INTERPOLATORS > 0
	// UV0 = splat position in the actor's bounds (0..1), handy for gradients and masks
	MaterialParameters.TexCoords[0] = ((LocalPosition - LocalBoundsOrigin) / max(LocalBoundsExtent, 1e-3f) * 0.5f + 0.5f).xz;
#endif

	FPixelMaterialInputs PixelMaterialInputs = (FPixelMaterialInputs)0;
	CalcPixelMaterialInputs(MaterialParameters, PixelMaterialInputs);

	const float3 Color = GetMaterialEmissive(PixelMaterialInputs);
	const float Opacity = ColorOpacity.w * GetMaterialOpacity(PixelMaterialInputs);
	RWSplatBuffer.Store4(Offset + FGaussianSplatShared::EFloat_ColorOpacityOffset, asuint(float4((Color - 0.5f) / SH_C0, Opacity)));
}
