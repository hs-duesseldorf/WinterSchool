// Dual-quaternion skinning of rest-pose Gaussian splats into GaussianSplat's float record format.
#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ComputeShaderUtils.ush"
#define GPU_SIMULATION 1
#include "/Plugin/GaussianSplat/Shared/GaussianSplatShared.h"

// per splat, 5 x float4:
//   0: position.xyz (component space), opacity
//   1: rotation quaternion xyzw
//   2: scale.xyz, asfloat(4 x uint8 bone indices)
//   3: SH0.xyz, 0
//   4: bone weights
StructuredBuffer<float4> RestSplats;
StructuredBuffer<float4> BoneDQ;   // 2 per bone: real xyzw, dual xyzw
uint NumSplats;
uint SplatStride;
RWByteAddressBuffer RWSplatBuffer;

float4 QMul(float4 A, float4 B)
{
	return float4(A.w * B.xyz + B.w * A.xyz + cross(A.xyz, B.xyz), A.w * B.w - dot(A.xyz, B.xyz));
}

[numthreads(THREADGROUP_SIZE_1D, 1, 1)]
void MainCS(uint3 GroupId : SV_GroupID, uint GroupThreadIndex : SV_GroupIndex)
{
	const uint Index = GetUnWrappedDispatchThreadId(GroupId, GroupThreadIndex, THREADGROUP_SIZE_1D);
	if (Index >= NumSplats)
	{
		return;
	}
	const float4 P = RestSplats[Index * 5 + 0];
	const float4 Q = RestSplats[Index * 5 + 1];
	const float4 S = RestSplats[Index * 5 + 2];
	const float4 C = RestSplats[Index * 5 + 3];
	const float4 W = RestSplats[Index * 5 + 4];
	const uint Packed = asuint(S.w);
	const uint4 B = uint4(Packed & 0xFFu, (Packed >> 8) & 0xFFu, (Packed >> 16) & 0xFFu, Packed >> 24);

	const float4 R0 = BoneDQ[B.x * 2];
	float4 Real = W.x * R0;
	float4 Dual = W.x * BoneDQ[B.x * 2 + 1];
	UNROLL
	for (uint i = 1; i < 4; ++i)
	{
		const float4 Ri = BoneDQ[B[i] * 2];
		const float Wi = W[i] * (dot(R0, Ri) < 0.0f ? -1.0f : 1.0f);
		Real += Wi * Ri;
		Dual += Wi * BoneDQ[B[i] * 2 + 1];
	}
	const float InvLen = rsqrt(max(dot(Real, Real), 1e-12f));
	Real *= InvLen;
	Dual *= InvLen;

	const float3 T = 2.0f * (Real.w * Dual.xyz - Dual.w * Real.xyz + cross(Real.xyz, Dual.xyz));
	const float3 Position = P.xyz + 2.0f * cross(Real.xyz, cross(Real.xyz, P.xyz) + Real.w * P.xyz) + T;
	float4 Rotation = QMul(Real, Q);
	Rotation *= rsqrt(max(dot(Rotation, Rotation), 1e-12f));

	const uint Offset = Index * SplatStride;
	RWSplatBuffer.Store3(Offset + FGaussianSplatShared::EFloat_PositionOffset, asuint(Position));
	RWSplatBuffer.Store3(Offset + FGaussianSplatShared::EFloat_ScaleOffset, asuint(S.xyz));
	RWSplatBuffer.Store4(Offset + FGaussianSplatShared::EFloat_RotationOffset, asuint(Rotation));
	RWSplatBuffer.Store3(Offset + FGaussianSplatShared::EFloat_ColorOpacityOffset, asuint(C.xyz));
	RWSplatBuffer.Store(Offset + FGaussianSplatShared::EFloat_ColorOpacityOffset + 12u, asuint(P.w));
}
